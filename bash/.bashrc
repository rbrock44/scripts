alias work='cd /c/workspace/'
alias g=git
alias gpull='git pull'
alias gpush='git push'
alias gpushn='git push --set-upstream origin $(git rev-parse --abbrev-ref HEAD)'
alias gc='git checkout'
alias ga='git add .'
alias gcm='git commit -m'
alias prod='npm run prod'
alias gro='git reset --hard @{u}'
alias pull-all='/c/workspace/scripts/bash/pull-all-repos.sh'
alias status-all='/c/workspace/scripts/bash/status-all-repos.sh'
